{
  "combat_advisor": {
    "agent_name": "combat_advisor",
    "agent_description": "Analyzes Gen 1 Pokémon battle mechanics, estimates damage ranges based on empirical formulas, tracks move PP economy, and evaluates tactical options.",
    "agent_system_prompt": "You are an analytical combat advisor for Pokémon Generation 1 (Pokémon Blue). Given party stats, enemy information, and current battle context, you evaluate type advantages, calculate expected physical and special damage ranges using verified Gen 1 formulas, assess enemy threats (e.g., status moves, Bide), track PP economy, and provide actionable tactical recommendations.",
    "agent_input_schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"user_pokemon\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"species\": {\"type\": \"string\"},\n        \"level\": {\"type\": \"integer\"},\n        \"hp_current\": {\"type\": \"integer\"},\n        \"hp_max\": {\"type\": \"integer\"},\n        \"attack\": {\"type\": \"integer\"},\n        \"defense\": {\"type\": \"integer\"},\n        \"speed\": {\"type\": \"integer\"},\n        \"special\": {\"type\": \"integer\"},\n        \"moves\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"name\": {\"type\": \"string\"},\n              \"type\": {\"type\": \"string\"},\n              \"power\": {\"type\": \"integer\"},\n              \"pp_current\": {\"type\": \"integer\"}\n            },\n            \"required\": [\"name\", \"type\", \"power\", \"pp_current\"]\n          }\n        }\n      },\n      \"required\": [\"species\", \"level\", \"hp_current\", \"hp_max\", \"attack\", \"defense\", \"speed\", \"special\", \"moves\"]\n    },\n    \"opponent_pokemon\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"species\": {\"type\": \"string\"},\n        \"level\": {\"type\": \"integer\"},\n        \"observed_moves\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\"}\n        },\n        \"estimated_types\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\"}\n        }\n      },\n      \"required\": [\"species\", \"level\"]\n    },\n    \"battle_context\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\"user_pokemon\", \"opponent_pokemon\", \"battle_context\"]\n}",
    "agent_output_schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"type_matchup_analysis\": {\"type\": \"string\"},\n    \"move_evaluations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"move_name\": {\"type\": \"string\"},\n          \"estimated_damage_min\": {\"type\": \"integer\"},\n          \"estimated_damage_max\": {\"type\": \"integer\"},\n          \"projected_ko_turns\": {\"type\": \"integer\"},\n          \"tactical_notes\": {\"type\": \"string\"}\n        },\n        \"required\": [\"move_name\", \"estimated_damage_min\", \"estimated_damage_max\", \"projected_ko_turns\", \"tactical_notes\"]\n      }\n    },\n    \"risk_factors\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\"}\n    },\n    \"recommended_action\": {\"type\": \"string\"},\n    \"reasoning\": {\"type\": \"string\"}\n  },\n  \"required\": [\"type_matchup_analysis\", \"move_evaluations\", \"risk_factors\", \"recommended_action\", \"reasoning\"]\n}"
  }
}